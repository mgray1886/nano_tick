[Unit]
Description=Nano Tick KDB-X writer (startup backfill + prune, then live MQTT -> HDB)
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# User/group/paths below are filled in by setup.sh at install time.
User=__USER__
Group=__GROUP__
WorkingDirectory=__APP_DIR__
EnvironmentFile=-__APP_DIR__/.env
# Runs app.py: backfill.run -> prune -> feedhandler (bridge, then live consume).
# Needs pykx (installed in the venv from requirements.txt) + a KDB-X licence at
# ~/.kx/kc.lic. HDB_PATH in .env must point at the SSD mount.
ExecStart=__APP_DIR__/venv/bin/python __REPO_DIR__/platform/app.py
Restart=always
RestartSec=10
# The writer is the memory-dominant 4B process: it holds the day's ticks in the
# in-memory RDB and buffers a BACKFILL_CHUNK of rows during backfill. On the 2GB
# 4B, run it INSTEAD of the recorder if memory is tight; raise/lower these with
# the symbol count and BACKFILL_CHUNK.
MemoryHigh=900M
MemoryMax=1200M
# savedown (RDB flush + bar/quoteBar materialise) runs on stop — give it room to
# finish so the current day isn't lost to a SIGKILL.
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
